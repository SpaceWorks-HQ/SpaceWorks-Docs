<sw-theme-toggle>
	<button type="button" class="sw-theme-toggle" aria-pressed="false">
		<svg class="to-dark" viewBox="0 0 24 24" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
			<path d="M20.5 13A8.5 8.5 0 0 1 11 3.5 8.5 8.5 0 1 0 20.5 13Z" />
		</svg>
		<svg class="to-light" viewBox="0 0 24 24" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round">
			<circle cx="12" cy="12" r="4" />
			<path d="M12 2v2m0 16v2M2 12h2m16 0h2M5 5l1.5 1.5m11 11L19 19M5 19l1.5-1.5m11-11L19 5" />
		</svg>
		<span class="sr-only">Dark theme</span>
	</button>
</sw-theme-toggle>

<script>
	const storageKey = 'starlight-theme';

	class SwThemeToggle extends HTMLElement {
		observer?: MutationObserver;
		controller?: AbortController;

		connectedCallback() {
			this.controller = new AbortController();
			const button = this.querySelector('button')!;
			const sync = () =>
				button.setAttribute(
					'aria-pressed',
					String(document.documentElement.dataset.theme === 'dark')
				);
			sync();
			// Header and mobile-menu controls observe the same theme state.
			this.observer = new MutationObserver(sync);
			this.observer.observe(document.documentElement, {
				attributes: true,
				attributeFilter: ['data-theme'],
			});
			button.addEventListener('click', () => {
				const next = document.documentElement.dataset.theme === 'dark' ? 'light' : 'dark';
				document.documentElement.dataset.theme = next;
				try {
					localStorage.setItem(storageKey, next);
				} catch {}
				sync();
			}, { signal: this.controller.signal });
		}

		disconnectedCallback() {
			this.observer?.disconnect();
			this.controller?.abort();
		}
	}
	customElements.define('sw-theme-toggle', SwThemeToggle);
</script>

<style>
	.sw-theme-toggle {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		width: 2.75rem;
		height: 2.75rem;
		border: 1px solid var(--sl-color-hairline);
		border-radius: 999px;
		background: transparent;
		color: var(--sl-color-gray-2);
		cursor: pointer;
	}
	.sw-theme-toggle:hover {
		color: var(--sl-color-white);
		border-color: var(--sl-color-gray-4);
	}
	.sw-theme-toggle :global(svg) {
		width: 1.1rem;
		height: 1.1rem;
	}
	:global([data-theme='light']) .to-light,
	:global([data-theme='dark']) .to-dark {
		display: none;
	}
</style>
